PORT=8000
DATABASE_URL=
RESOURCE_STORAGE_PATH=./data/resources
OCR_WORKER_URL=http://localhost:8100
NODE_ENV=development

# Translation: mymemory (default, no key needed) | bhashini | none
TRANSLATION_PROVIDER=mymemory
BHASHINI_API_KEY=
BHASHINI_PIPELINE_URL=

# ABDM: simulated (default, no credentials needed) | sandbox
ABDM_PROVIDER=simulated
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_CERTIFICATE_PATH=

# ASR: Groq's free-tier hosted Whisper. Get a free key at https://console.groq.com
GROQ_API_KEY=