{"name":"setu-health","private":true,"workspaces":["apps/*","services/*","packages/*"],"scripts":{"dev":"npm --workspace @setu/prism-api run dev","dev:web":"npm --workspace @setu/patient-web run dev","dev:medbridge":"npm --workspace @setu/medbridge-web run dev","dev:ocr":"python -m uvicorn main_lite:app --app-dir services/prism-ocr-worker --host 0.0.0.0 --port 8100","build":"npm --workspace @setu/patient-web run build","build:medbridge":"npm --workspace @setu/medbridge-web run build","test":"npm --workspace @setu/prism-api test","demo":"concurrently -k -n OCR,API,PATIENT,MEDBRIDGE -c yellow,green,cyan,magenta \"npm run dev:ocr\" \"npm run dev\" \"npm run dev:web\" \"npm run dev:medbridge\""},"devDependencies":{"concurrently":"^10.0.5"}}