{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setu-health.dev/schema/v0/clinical-evidence.json",
  "title": "SETU Clinical Evidence",
  "description": "A provenance-preserving, pathway-aware and resource-grounded clinical fact exchanged between PRISM, document intelligence, interoperability adapters and downstream clinical services.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "clinicalPathway",
    "source",
    "sourceClass",
    "value",
    "resourceRefs",
    "verification",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "clinicalPathway": {
      "type": "string",
      "enum": [
        "allopathic",
        "ayush",
        "cross_cutting",
        "unknown"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "patient",
        "document",
        "fhir",
        "clinician",
        "system"
      ]
    },
    "sourceClass": {
      "type": "string",
      "enum": [
        "patient_reported",
        "patient_provided_document",
        "abdm_exchange",
        "clinician_confirmed",
        "system_derived",
        "unknown"
      ]
    },
    "captureMethod": {
      "type": "string",
      "enum": [
        "voice",
        "touch",
        "ocr",
        "fhir",
        "manual",
        "derived"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "originalValue": {},
    "value": {},
    "normalized": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {},
        "referenceRange": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {},
            "high": {},
            "unit": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "historical",
        "resolved",
        "denied",
        "unknown",
        "entered_in_error"
      ]
    },
    "certainty": {
      "type": "string",
      "enum": [
        "stated",
        "probable",
        "possible",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourceType",
          "resourceId"
        ],
        "properties": {
          "resourceType": {
            "type": "string",
            "enum": [
              "conversation_turn",
              "touch_response",
              "document",
              "fhir_resource",
              "clinician_review",
              "system_process"
            ]
          },
          "resourceId": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "hash": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unverified",
            "patient_reported",
            "extracted_from_document",
            "abdm_exchange",
            "clinician_confirmed",
            "system_derived",
            "unknown"
          ]
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verifiedBy": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "ingestedAt"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceTitle": {
          "type": "string"
        },
        "facility": {
          "type": "string"
        },
        "eventDate": {
          "type": "string",
          "format": "date-time"
        },
        "ingestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "locator": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
