# SETU environment template
# Never commit real secrets. Copy into a local secret store / .env for development.

NODE_ENV=development

# Application
SETU_API_BASE_URL=
SETU_WEB_BASE_URL=

# Database
DATABASE_URL=

# AI / model providers
LLM_PROVIDER=
LLM_API_KEY=

# Speech
# ASR: Groq's free-tier hosted Whisper (whisper-large-v3-turbo). Get a free key
# at https://console.groq.com — used instead of the browser's built-in speech
# recognition because its accuracy was not good enough.
ASR_PROVIDER=groq
GROQ_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# Translation: mymemory (default, no key needed) | bhashini | none
TRANSLATION_PROVIDER=mymemory
BHASHINI_API_KEY=
BHASHINI_PIPELINE_URL=

# OCR / document intelligence
OCR_PROVIDER=
OCR_API_KEY=

# ABDM push adapter: simulated (default, no credentials needed) | sandbox
ABDM_PROVIDER=simulated

# ABDM / FHIR — values must come from the current approved sandbox/production contract
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_CERTIFICATE_PATH=
ABDM_PRIVATE_KEY_PATH=
FHIR_BASE_URL=

# Messaging (prototype/integration layer)
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Security
SESSION_SECRET=
ENCRYPTION_KEY=
